rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rooms are public for instant join without login (using client generated peer IDs)
    match /rooms/{roomId} {
      allow read, write: if true;

      match /participants/{participantId} {
        allow read, write: if true;
      }

      match /messages/{messageId} {
        allow read, write: if true;
      }

      match /reactions/{reactionId} {
        allow read, write: if true;
      }

      match /signals/{signalId} {
        allow read, write: if true;
      }
    }

    // Active calls tracked by IP for the 5-calls limit per IP
    match /ip_active_calls/{callId} {
      allow read, write: if true;
    }
  }
}
