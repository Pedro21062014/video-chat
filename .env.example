# ==============================================================================
# VARIÁVEIS DE AMBIENTE - CLOUDFLARE PAGES & FIREBASE
# Configure estas variáveis no painel da Cloudflare Pages (Settings > Environment variables)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FIREBASE (Obrigatório para persistência de salas, participantes, chat e reações)
# Obtenha estas credenciais no Firebase Console (Configurações do Projeto > Geral > Seus aplicativos > Web)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Opcional: Especifique se estiver usando uma base de dados nomeada do Firestore.
# Deixe vazio se estiver usando o banco "(default)".
NEXT_PUBLIC_FIREBASE_FIRESTORE_DATABASE_ID=""

# ------------------------------------------------------------------------------
# 2. PEERJS (Opcional - Servidor de Sinalização P2P)
# Se deixar em branco, o aplicativo usa automaticamente a nuvem pública gratuita da PeerJS (0.peerjs.com).
# Preencha apenas se hospedar seu próprio servidor PeerServer (ex: Cloudflare Worker, VPS, Docker).
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PEERJS_HOST=""
NEXT_PUBLIC_PEERJS_PORT=""
NEXT_PUBLIC_PEERJS_PATH=""
NEXT_PUBLIC_PEERJS_KEY=""
NEXT_PUBLIC_PEERJS_SECURE=""

# ------------------------------------------------------------------------------
# 3. CLOUDFLARE PAGES / BUILD
# ------------------------------------------------------------------------------
# NODE_VERSION: Recomendado definir como 20 nas variáveis do Cloudflare Pages
NODE_VERSION="20"

# OUTPUT_EXPORT: Se utilizar o preset "Next.js (Static HTML Export)" do Cloudflare Pages.
# O projeto já detecta automaticamente CF_PAGES=1, mas você também pode forçar explicitamente:
OUTPUT_EXPORT="true"

# ------------------------------------------------------------------------------
# 4. OUTRAS VARIÁVEIS
# ------------------------------------------------------------------------------
GEMINI_API_KEY=""
APP_URL=""
